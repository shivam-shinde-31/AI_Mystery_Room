NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/ai-mystery-room?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_EMERGENCY_MODEL=gemini-3.5-flash-lite
AI_DEEP_VALIDATION=false
MAX_TOKENS_PER_CASE=120000
GENERATION_CONCURRENCY=2
EVIDENCE_CONCURRENCY=4
GUEST_CASE_LIMIT=5
USER_DAILY_CASE_LIMIT=10
STORAGE_DRIVER=local
AI_MOCK=true
VITE_API_BASE_URL=http://localhost:4000/api/v1
